# Where `make deploy`, `make status`, `make backup`... run, over ssh. Copy to deploy/target.env (gitignored).
# The server needs git, Docker with Compose v2, and a clone of this repo at REMOTE_PATH with its own .env.
REMOTE_HOST=user@my-server
REMOTE_PATH=~/Fit-OS
# DATA_DIR on the server, as an ssh-relative or absolute path (for seed-remote and backup-check).
REMOTE_DATA=~/fit-os-data
# Your age private key, used only by `make backup-check` on this machine.
AGE_KEY=~/.config/fit-os/backup-age.key
# Files `make seed` / `make seed-remote` import (under data/import, gitignored).
PROFILE_YAML=data/import/profile.yaml
LABS_CSV=data/import/labs.csv
