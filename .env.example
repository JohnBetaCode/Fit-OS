# Fit-OS configuration. Copy to .env (`make dev` does it for you) and fill in. Never commit .env.
# No comments at the end of a line: docker compose would keep them as part of the value.

# ── App ──────────────────────────────────────────────────────────────────────────
APP_ENV=production
# Your timezone: calendar days, morning plan, quiet hours.
TZ=UTC
# Language of the dashboard and WhatsApp messages: en | es (also switchable in Settings).
# Commands are understood in both languages either way.
DEFAULT_LANGUAGE=en
# Where the SQLite DB, media, labs and backups live on the host (outside the repo).
DATA_DIR=./data
APP_PORT=8090
LOG_LEVEL=INFO

# ── Dashboard access ─────────────────────────────────────────────────────────────
# Sidecars to start: `edge` = Caddy (HTTPS + basic_auth), `waha` = bundled WhatsApp gateway. E.g. edge,waha
COMPOSE_PROFILES=
EDGE_PORT=8444
# Plain-HTTP port on 127.0.0.1 for a local TLS proxy such as `tailscale serve` (docs/deployment.md)
EDGE_LOCAL_PORT=8445
# Random string shared by Caddy and the app (`openssl rand -hex 32`). Required with the edge profile.
PROXY_SECRET=
# Base URL used in links sent to WhatsApp, e.g. https://192.168.1.20:8444
PORTAL_BASE_URL=
# Alternative to Caddy: `tailscale serve` in front adds Tailscale-User-Login. Only enable it if that is
# the ONLY way in, and list the allowed logins.
TRUST_TAILSCALE_HEADERS=false
OWNER_LOGINS=
DEV_USER_LOGIN=
# Subnet of the wa-shared docker network: peers there only reach /healthz and /webhooks/waha.
# `docker network inspect wa-shared -f '{{(index .IPAM.Config 0).Subnet}}'`
PEER_NET_CIDR=
SECRETS_KEY=

# ── WhatsApp (WAHA) ──────────────────────────────────────────────────────────────
WAHA_MODE=live
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
# HMAC key WAHA signs webhooks with (`openssl rand -hex 32`).
WAHA_WEBHOOK_HMAC_KEY=
# session = Fit-OS adds its own webhook to a WAHA shared with other apps (make waha-hook).
# global  = the bundled WAHA (profile waha) posts every event to Fit-OS.
WAHA_HOOK_MODE=session
# The group Fit-OS lives in (`make wa-groups MATCH=Gym` lists ids). Every other chat is ignored.
WA_GYM_CHAT_ID=
WA_NETWORK=wa-shared
WA_MAX_PER_HOUR=120
# Bundled WAHA only (profile waha).
WAHA_IMAGE=devlikeapro/waha:latest
WAHA_DASHBOARD_PASSWORD=

# ── Coach (optional) ─────────────────────────────────────────────────────────────
# off = fully deterministic app (plans, logging, progression, swaps all work). live = Claude coach.
LLM_MODE=off
ANTHROPIC_API_KEY=
LLM_COACH_MODEL=claude-opus-5-5
LLM_FAST_MODEL=claude-haiku-5-5

# ── Backups ──────────────────────────────────────────────────────────────────────
# age public key(s) backups are encrypted to; the private key stays on your laptop.
BACKUP_RECIPIENTS_FILE=
# Nightly backup schedule, server time (cron syntax).
BACKUP_CRON=20 3 * * *
