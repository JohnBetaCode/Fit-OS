# Fit-OS — shortcuts. `make help` lists them.
#
# Local targets run on this machine. Remote targets (deploy, status, backup, seed-remote, ...) run over ssh
# on the host in deploy/target.env (copy deploy/target.env.example). If you run Fit-OS on this same
# machine, use the server script directly: `bash ops/server.sh deploy|status|backup|rollback`.
SHELL := /bin/bash
COMPOSE ?= docker compose
DEV = $(COMPOSE) -f docker-compose.yml -f docker-compose.dev.yml

-include deploy/target.env
REMOTE_HOST ?=
REMOTE_PATH ?= ~/Fit-OS
REMOTE_DATA ?= ~/fit-os-data
PROFILE_YAML ?= data/import/profile.yaml
LABS_CSV ?= data/import/labs.csv
export REMOTE_HOST REMOTE_DATA AGE_KEY

.PHONY: help venv test lint network dev down logs shell revision demo seed catalog user-add users \
	status deploy rollback backup install-cron backup-check seed-remote catalog-remote demo-remote \
	wa-groups waha-hook remote-logs _remote

help: ## List the commands
	@grep -hE '^[a-zA-Z_-]+:.*?## ' Makefile | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

# ── Local ────────────────────────────────────────────────────────────────────────
venv: ## Local env for tests and lint (app/.venv)
	cd app && python3 -m venv .venv && . .venv/bin/activate && pip install -q -r requirements.txt && pip install -q -e ".[dev]"

test: ## Tests (in-memory SQLite, no Docker)
	cd app && . .venv/bin/activate && pytest -q

lint: ## Ruff
	cd app && . .venv/bin/activate && ruff check fitos tests

network: ## Create the shared docker network for WhatsApp (once per host)
	@docker network inspect $${WA_NETWORK:-wa-shared} >/dev/null 2>&1 || docker network create $${WA_NETWORK:-wa-shared}

dev: network ## Local stack with reload, fake WAHA and Claude: http://localhost:8090 and /dev/wa
	@[ -f .env ] || cp .env.example .env
	$(DEV) build fitos
	$(DEV) run --rm fitos fitos migrate
	$(DEV) up -d fitos

down: ## Stop the local stack
	$(DEV) down

logs: ## Follow logs
	$(DEV) logs -f --tail=200 fitos

shell: ## Shell in the container
	$(DEV) exec fitos bash

revision: ## New autogenerated migration: make revision m="..."
	cd app && . .venv/bin/activate && d=$$(mktemp -d) && \
		DATABASE_URL=sqlite:///$$d/gen.sqlite alembic upgrade head && \
		DATABASE_URL=sqlite:///$$d/gen.sqlite alembic revision --autogenerate -m "$(m)"

catalog: ## Exercise bank locally: download dataset, GIF→MP4, import (~10 min, ~220 MB)
	$(DEV) exec fitos fitos catalog fetch
	$(DEV) exec fitos fitos catalog build-media
	$(DEV) exec fitos fitos catalog import

demo: ## Fill an empty local DB with synthetic data (needs `make catalog` first)
	$(DEV) exec fitos fitos demo seed

seed: ## Import your profile and labs locally (PROFILE_YAML, LABS_CSV under data/import, gitignored)
	$(DEV) exec fitos fitos profile import /$(PROFILE_YAML)
	$(DEV) exec fitos fitos labs import-seed /$(LABS_CSV)

user-add: ## New account with its own database (dev): make user-add U=ana NAME="Ana" [ROLE=admin]
	@[ -n "$(U)" ] || { echo "usage: make user-add U=<username> [NAME=...] [ROLE=admin]"; exit 2; }
	$(DEV) exec fitos fitos users add $(U) --name "$(or $(NAME),$(U))" --role $(or $(ROLE),user)

users: ## Accounts (dev)
	$(DEV) exec -T fitos fitos users list

# ── Remote (deploy/target.env) ───────────────────────────────────────────────────
# Runs the origin/main version of ops/server.sh on the server: push before deploying.
_remote:
	@[ -n "$(REMOTE_HOST)" ] || { echo "no REMOTE_HOST: cp deploy/target.env.example deploy/target.env and edit it"; exit 2; }
REMOTE_SH = ssh -n $(REMOTE_HOST) 'cd $(REMOTE_PATH) && git fetch -q origin && git show origin/main:ops/server.sh > /tmp/fit-os-server.sh && FORCE=$(FORCE) ADOPT_AS=$(ADOPT_AS) bash /tmp/fit-os-server.sh'
REMOTE_EXEC = ssh -n $(REMOTE_HOST) 'cd $(REMOTE_PATH) && docker compose exec -T -e FITOS_USER=$(U) fitos

status: _remote ## Server status: commit, schema, containers, memory, deploys, backups
	$(REMOTE_SH) status

deploy: _remote ## Deploy origin/main (backup, build, migrate, start, health check)
	$(REMOTE_SH) deploy

rollback: _remote ## Back to the commit (and DB) from before the last deploy
	$(REMOTE_SH) rollback

backup: _remote ## Encrypted DB backup on the server
	$(REMOTE_SH) backup manual

install-cron: _remote ## Install the nightly backup on the server (BACKUP_CRON)
	$(REMOTE_SH) install-cron

backup-check: _remote ## Fetch, decrypt (AGE_KEY) and verify the newest server backup
	bash ops/restore-check.sh

remote-logs: _remote ## Last 200 log lines on the server
	ssh -n $(REMOTE_HOST) 'cd $(REMOTE_PATH) && docker compose logs --tail=200 fitos'

catalog-remote: _remote ## Exercise bank on the server (download, GIF→MP4, import)
	$(REMOTE_EXEC) fitos catalog fetch'
	$(REMOTE_EXEC) fitos catalog build-media'
	$(REMOTE_EXEC) fitos catalog import'

demo-remote: _remote ## Synthetic demo data on the server (only into an empty DB)
	$(REMOTE_EXEC) fitos demo seed'

seed-remote: _remote ## Copy your profile and labs by scp (never git) and import them on the server
	ssh -n $(REMOTE_HOST) 'mkdir -p $(REMOTE_DATA)/import && chmod 700 $(REMOTE_DATA)'
	scp $(PROFILE_YAML) $(LABS_CSV) $(REMOTE_HOST):$(REMOTE_DATA)/import/
	$(REMOTE_EXEC) fitos profile import /data/import/$(notdir $(PROFILE_YAML))'
	$(REMOTE_EXEC) fitos labs import-seed /data/import/$(notdir $(LABS_CSV))'

wa-groups: _remote ## WhatsApp groups whose name contains MATCH (default "Gym"), for WA_GYM_CHAT_ID
	$(REMOTE_EXEC) fitos wa groups --match "$(or $(MATCH),Gym)"'

waha-hook: _remote ## Session webhook on a shared WAHA: ACTION=show|add|remove (add/remove need CONFIRM=1)
	ssh -n $(REMOTE_HOST) 'cd $(REMOTE_PATH) && CONFIRM=$(CONFIRM) bash ops/waha-webhook.sh $(or $(ACTION),show)'
